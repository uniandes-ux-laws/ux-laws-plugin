        "requiere_lectura": false
      },
      {
        "campo": "P",
        "decide": "Si el único aislado coincide con lo que la pantalla promueve.",
        "evidencia": "etiquetas y jerarquía del screenshot",
        "requiere_lectura": true,
        "canal_de_lectura": "screenshot",
        "comparacion_entre_canales": "no aplica: G4 corre solo sobre screenshot"
