    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation",
          "node_ids",
          "region",
          "severity"
        ],
        "properties": {
          "observation": {
            "type": "string"
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "region": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            }
          },
