{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "group_id",
    "group_name",
    "laws_subsumed",
    "channel",
    "not_applicable",
    "na_reason",
    "score",
    "trigger",
    "measurements",
    "findings",
    "recommendations",
    "evidence_insufficient",
    "run"
  ],
  "properties": {
    "group_id": {
      "type": "string",
      "const": "g4"
    },
    "group_name": {
      "type": "string"
    },
    "laws_subsumed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "channel": {
      "type": "string",
      "const": "screenshot"
    },
    "not_applicable": {
      "type": "boolean"
    },
    "na_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "score": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 4
    },
    "trigger": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Bn",
        "I",
        "P",
        "Cn",
        "canales",
        null
      ]
    },
    "evidence_insufficient": {
      "type": "boolean"
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sets",
        "g4_conjuntos_pares_total",
        "I_total",
        "Bn",
        "Cn",
        "channels_of_isolation",
        "I_principal",
        "P",
        "main_set_id",
        "jerarquia_entre_dos",
        "ancla_definida",
        "motivo_abstencion",
        "Bn_ids",
        "Cn_ids",
        "canales_aislamiento",
        "lectura_screenshot",
        "juicios_conjuntos",
        "main_set_justification"
      ],
      "properties": {
        "sets": {
          "type": "integer",
          "minimum": 0
        },
        "g4_conjuntos_pares_total": {
          "type": "integer",
          "minimum": 0
        },
        "I_total": {
          "type": "integer",
          "minimum": 0
        },
        "Bn": {
          "type": "integer",
          "minimum": 0
        },
        "Cn": {
          "type": "integer",
          "minimum": 0
        },
        "channels_of_isolation": {
          "type": "integer",
          "minimum": 0
        },
        "I_principal": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "P": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "main_set_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "jerarquia_entre_dos": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "ancla_definida": {
          "type": "boolean"
        },
        "motivo_abstencion": {
          "type": [
            "string",
            "null"
          ]
        },
        "Bn_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "Cn_ids": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "canales_aislamiento": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "color",
              "peso",
              "tamaño",
              "borde"
            ]
          }
        },
        "lectura_screenshot": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "P"
            ]
          },
          "uniqueItems": true
        },
        "juicios_conjuntos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conjunto",
              "equivalentes",
              "aislados_ids"
            ],
            "properties": {
              "conjunto": {
                "type": "string"
              },
              "equivalentes": {
                "type": "boolean"
              },
              "aislados_ids": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "main_set_justification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observation",
          "node_ids",
          "region",
          "severity"
        ],
        "properties": {
          "observation": {
            "type": "string"
          },
          "node_ids": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "region": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "w",
              "h"
            ],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            }
          },
          "severity": {
            "type": "string",
            "enum": [
              "alta",
              "media",
              "baja"
            ]
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "prompt_hash",
        "repetition",
        "runtime",
        "captured_at",
        "decoding",
        "capture_sha256",
        "measurements_version",
        "protocol_version"
      ],
      "description": "Metadata de trazabilidad. Sin ella un resultado no es atribuible a una configuración declarada.",
      "properties": {
        "model_id": {
          "type": "string",
          "pattern": "^(?!.*\\s)(?=[^\\s]*[0-9])(?=[^\\s]*[-._:])[A-Za-z0-9][A-Za-z0-9._:@/-]{5,}$",
          "$comment": "Patrón ECMAScript compatible con Node 20. Los marcadores de posición enumerados en el orquestador no contienen dígitos y ya se rechazan por el requisito de versión, también en mayúsculas. No hace falta el modificador local (?i:...). La prohibición explícita de espacios evita que $ acepte un salto de línea final.",
          "description": "Identificador exacto del modelo, no el nombre comercial del producto. El patrón exige una versión y un separador, y rechaza marcadores de posición como \"pendiente\" y nombres comerciales con espacios como \"Claude Opus 5\". Un dataset con model_id inservible no se arregla después: la corrida se repite entera."
        },
        "prompt_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "sha256 del texto de la rúbrica y la plantilla efectivamente enviados."
        },
        "repetition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "Índice de repetición. El protocolo fija cinco por configuración."
        },
        "runtime": {
          "type": "string",
          "description": "Runtime de agente que ejecutó la skill."
        },
        "decoding": {
          "type": "object",
          "description": "Parámetros de decodificación empleados. Obligatorio desde v0.2.0: cambian la salida, así que o se declaran, o se declara explícitamente que el runtime no los expone ({\"declarado\": \"no expuesto por el runtime\"}). Lo que no se admite es el silencio.",
          "additionalProperties": true,
          "minProperties": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "capture_sha256": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "screenshot",
            "wireframe"
          ],
          "description": "Los sha256 de las dos representaciones evaluadas, copiados de meta.json. Obligatorio desde v0.2.0, y objeto y no cadena: ata el puntaje a unos bytes concretos y no a una URL, que sirve otra página cada semana. Antes era una cadena opcional, con lo cual un resultado podía no decir qué capturó evaluó.",
          "properties": {
            "screenshot": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "wireframe": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "measurements_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "schema_version del measurements.json que la skill recibió. Es atribución: la misma rúbrica sobre cifras producidas por otra versión de la capa de medición da otro puntaje, y sin este campo esa diferencia sería indistinguible de un cambio de juicio."
        },
        "protocol_version": {
          "type": "string",
          "description": "Versión del protocolo bajo la que corrió, por ejemplo 0.1.0. El prompt_hash ya identifica el texto exacto, pero resolver un hash exige tener el repositorio; esto hace el resultado legible por sí solo."
        }
      }
    }
  }
}
